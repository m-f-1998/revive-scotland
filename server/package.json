{
  "name": "revive-scotland-server",
  "version": "1.0.0",
  "description": "Server for Revive Scotland",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prestart": "npm i",
    "start": "node --env-file=.env --watch ./ index.js",
    "dev": "npm run prestart && npx --yes nodemon -e ts --exec \"tsc && node ./dist/index.js\"",
    "lint": "npx --yes eslint",
    "lint:fix": "npx --yes eslint --fix",
    "tsc-verify": "npx --yes tsc --noEmit",
    "test": "tsc && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@google-analytics/data": "^7.3.0",
    "body-parser": "^2.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "mime": "^4.1.1",
    "pino-pretty": "^13.2.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mime": "^3.0.4",
    "@types/sanitize-html": "^2.16.2",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "volta": {
    "node": "24.22.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
