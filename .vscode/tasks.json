{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Server (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Angular Client (ng serve)",
      "type": "shell",
      "command": "ng serve",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Stripe CLI Webhook (Stripe listen)",
      "type": "shell",
      "command": "stripe listen --forward-to http://localhost:3000/api/events/stripe/webhook",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Fullstack",
      "dependsOn": [
        "Run Server (npm run dev)",
        "Run Angular Client (ng serve)",
        "Run Stripe CLI Webhook (Stripe listen)"
      ]
    }
  ]
}